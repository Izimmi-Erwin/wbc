        string assetLicense = "CC-BY-NC-4.0"
        string assetRepository = "https://huggingface.co/datasets/limxdynamics/FluxBisimAssets"
        string assetRevision = "1a5b6336d7752c3b605b196ae9a4e159bef3c028"
        string description = "FluxBisim kitchen with fixed island plate spawn and randomized banana on sink-right countertop; WBC support ground retained."
        string physicsOverrides = "Island: 16 static colliders. L-shaped Kitchen_Cabinet002: all 53 static colliders enabled (25 body, 16 door, 12 drawer). Other kitchen collisions/rigid bodies/joints disabled. Plate: dynamic, 0.2 kg. Banana: dynamic, 0.15 kg. Both retain source convexDecomposition collision."
        string placement = "Inverse of upstream base_kitchen XY/yaw: translate (0.53,0.2,0), rotate Z -90 degrees."
        string platePose = "Fixed world (0.60,-0.05,0.75) on island; original FluxBisim quaternion and approximately 0.21 m diameter retained."
        string sourceFixes = "Deactivate absent duplicate Kitchen_Wall001_01; correct shelf texture filename."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

